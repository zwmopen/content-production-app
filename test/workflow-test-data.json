  },

  "expectedDispatchOrder": {
    "separated-archive": [
      "upload-material → handleUploadMaterial",
      "wait-random → executeUtilityStep (随机等待)",
      "wait-plan → handleWaitPlan",
      "send-confirm → handleSendConfirm",
      "wait-random → executeUtilityStep (随机等待)",
      "wait-images → handleWaitImages",
      "request-copy → handleRequestCopy",
      "wait-random → executeUtilityStep (随机等待)",
      "wait-copy → handleWaitCopy",
      "save-text → handleArchive(step) [action=save-text]",
      "download-images → handleArchive(step) [action=download-images]",
      "move-archive → handleArchive(step) [action=move-archive → archivePackageReply]"
    ],
    "combined-archive": [
      "upload-material → handleUploadMaterial",
      "wait-plan → handleWaitPlan",
      "send-confirm → handleSendConfirm",
      "wait-images → handleWaitImages",
      "request-copy → handleRequestCopy",
      "wait-copy → handleWaitCopy",
      "package-archive → handleArchive(step) [action=package-archive → save TXT + download + archivePackageReply]"
    ],
    "mixed-utility-steps": [
      "time-window → executeUtilityStep (时间窗口检查)",
      "upload-material → handleUploadMaterial",
      "wait-fixed → executeUtilityStep (固定等待 3s)",
      "detect-plan → executeUtilityStep (瞬间检测计划)",
      "wait-plan → handleWaitPlan",
      "send-text → executeUtilityStep (发送文字)",
      "send-confirm → handleSendConfirm",
      "wait-random → executeUtilityStep (随机等待 2-6s)",
      "detect-generating → executeUtilityStep (检测GPT生成中)",
      "wait-images → handleWaitImages",
      "detect-images → executeUtilityStep (瞬间检测图片)",
      "request-copy → handleRequestCopy",
      "wait-copy → handleWaitCopy",
      "detect-copy → executeUtilityStep (瞬间检测文案)",
      "clipboard-copy → executeUtilityStep (复制到剪贴板)",
      "retry → executeUtilityStep (重试配置)",
      "save-text → handleArchive(step) [action=save-text]",
      "download-images → handleArchive(step) [action=download-images]",
      "move-archive → handleArchive(step) [action=move-archive → archivePackageReply]"
    ],
    "partial-disabled": [
      "upload-material → handleUploadMaterial",
      "wait-plan → handleWaitPlan",
      "send-confirm → handleSendConfirm",
      "wait-images → handleWaitImages",
      "request-copy → 跳过 (enabled=false)",
      "wait-copy → 跳过 (enabled=false)",
      "save-text → 跳过 (enabled=false)",
      "download-images → handleArchive(step) [action=download-images]",
      "move-archive → handleArchive(step) [action=move-archive → archivePackageReply]"
    ],
    "combined-with-autopackage-off": [
      "upload-material → handleUploadMaterial",
      "wait-plan → handleWaitPlan",
      "send-confirm → handleSendConfirm",
      "wait-images → handleWaitImages",
      "request-copy → handleRequestCopy",
      "wait-copy → handleWaitCopy",
      "package-archive → handleArchive(step) [action=package-archive → earlyReturn: packageSkipped=true]"
    ]
  }
}
